# ─── Core ────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/missive

# ─── Auth ────────────────────────────────────────────────
BETTER_AUTH_SECRET=your-secret-key-min-32-chars-here-replace-me
BETTER_AUTH_URL=http://localhost:3000

# ─── Email ───────────────────────────────────────────────
# Comma-separated list of enabled transports. Valid values: ses, smtp
# Order matters: the first entry is used when the API caller does not
# specify a transport. Both can be listed at the same time.
#
#   EMAIL_TRANSPORTS=ses          # SES only
#   EMAIL_TRANSPORTS=smtp         # SMTP only
#   EMAIL_TRANSPORTS=ses,smtp     # both enabled; SES is the default
#   EMAIL_TRANSPORTS=smtp,ses     # both enabled; SMTP is the default
#
EMAIL_TRANSPORTS=ses
EMAIL_FROM="Missive <noreply@yourdomain.com>"

# ─── SES Transport ───────────────────────────────────────
# Required when "ses" is in EMAIL_TRANSPORTS.
# Use the Terraform output in infra/ to provision these credentials.
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── SMTP Transport ──────────────────────────────────────
# Required when "smtp" is in EMAIL_TRANSPORTS.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# ─── Test Script ─────────────────────────────────────────
# Create an API key in the dashboard (Settings → API Keys)
# Then add it here for the test script:
# MISSIVE_API_KEY=mk_your_generated_key_here
#
# Default recipient for npm run send-test.
# When using SES sandbox, this address must be verified in AWS SES.
# TEST_EMAIL_TO=you@yourdomain.com
