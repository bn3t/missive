# ─── Core ────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/missive

# ─── Auth ────────────────────────────────────────────────
BETTER_AUTH_SECRET=your-secret-key-min-32-chars-here-replace-me
BETTER_AUTH_URL=http://localhost:3000

# ─── Email Transport ─────────────────────────────────────
# "ses", "smtp", or "mailhog" (for local testing with MailHog)
EMAIL_TRANSPORT=mailhog
EMAIL_FROM="Missive <noreply@localhost>"

# ─── SES Transport (when EMAIL_TRANSPORT=ses) ───────────
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── SMTP Transport (when EMAIL_TRANSPORT=smtp) ─────────
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# ─── MailHog (when EMAIL_TRANSPORT=mailhog) ─────────────
# MailHog *does* simulate a full SMTP server (listens on port 1025).
# All emails sent via Nodemailer are captured instead of delivered.
# View captured emails + HTML previews at http://localhost:8025
MAILHOG_HOST=localhost
MAILHOG_PORT=1025

# ─── Test Script ────────────────────────────────────────
# Create an API key in the dashboard (Settings → API Keys)
# Then add it here for the test script:
# MISSIVE_API_KEY=mk_your_generated_key_here
