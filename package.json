{
  "name": "missive",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "compile": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "dev": "next dev",
    "fallow": "fallow dupes --regression-baseline fallow-dupes-baseline.json --fail-on-regression",
    "lint:fix": "eslint --fix",
    "lint": "eslint",
    "seed": "tsx --env-file=.env.local seed.ts",
    "send-test-pdf": "tsx --env-file=.env.local scripts/send-test-pdf.ts",
    "send-test": "tsx --env-file=.env.local scripts/send-test-email.ts",
    "migrate:deploy": "tsx scripts/migrate.ts",
    "start": "tsx scripts/migrate.ts && next start",
    "test:watch": "vitest",
    "test": "vitest run",
    "validate": "npm run compile && npm run fallow && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1029.0",
    "@base-ui/react": "^1.3.0",
    "@orpc/client": "^1.13.14",
    "@orpc/contract": "^1.13.14",
    "@orpc/server": "^1.13.14",
    "@orpc/shared": "^1.13.14",
    "@orpc/zod": "^1.13.14",
    "better-auth": "^1.4.22",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.8.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "nodemailer": "^8.0.5",
    "pg": "^8.20.0",
    "react": "19.2.5",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.5",
    "server-only": "^0.0.1",
    "shadcn": "^4.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "dotenv": "^17.4.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "fallow": "^2.85.0",
    "jsdom": "^29.0.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.4"
  }
}
