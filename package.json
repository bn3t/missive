{
  "name": "missive",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "compile": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "dev": "next dev --port 3100",
    "fallow": "fallow dupes --regression-baseline fallow-dupes-baseline.json --fail-on-regression",
    "lint:fix": "eslint --fix",
    "lint": "eslint",
    "seed": "tsx --env-file=.env.local seed.ts",
    "seed:deploy": "tsx seed.ts",
    "send-test-pdf": "tsx --env-file=.env.local scripts/send-test-pdf.ts",
    "send-test": "tsx --env-file=.env.local scripts/send-test-email.ts",
    "migrate:deploy": "tsx scripts/migrate.ts",
    "start": "tsx scripts/migrate.ts && next start",
    "test:watch": "vitest",
    "test": "vitest run",
    "validate": "npm run compile && npm run fallow && npm run lint && npm run test && npm run build",
    "ncu": "ncu -u",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1090.0",
    "@base-ui/react": "^1.6.0",
    "@better-auth/api-key": "^1.6.23",
    "@orpc/contract": "^1.14.8",
    "@orpc/server": "^1.14.8",
    "@orpc/zod": "^1.14.8",
    "better-auth": "^1.6.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.25.0",
    "next": "16.2.10",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "react": "19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.7",
    "shadcn": "^4.13.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "postcss": "8.5.15",
    "esbuild": "0.28.1",
    "@babel/plugin-transform-runtime": "^7.29.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "fallow": "^3.6.0",
    "jsdom": "^29.1.1",
    "npm-check-updates": "^22.2.9",
    "tailwindcss": "^4",
    "typescript": "^6",
    "vitest": "^4.1.10"
  }
}
