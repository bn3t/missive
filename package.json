{
  "name": "missive",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "compile": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "dev": "next dev --port 3100",
    "fallow": "fallow dupes --regression-baseline fallow-dupes-baseline.json --fail-on-regression",
    "lint:fix": "eslint --fix",
    "lint": "eslint",
    "seed": "tsx --env-file=.env.local seed.ts",
    "send-test-pdf": "tsx --env-file=.env.local scripts/send-test-pdf.ts",
    "send-test": "tsx --env-file=.env.local scripts/send-test-email.ts",
    "migrate:deploy": "tsx scripts/migrate.ts",
    "start": "tsx scripts/migrate.ts && next start",
    "test:watch": "vitest",
    "test": "vitest run",
    "validate": "npm run compile && npm run fallow && npm run lint && npm run test && npm run build",
    "ncu": "ncu -u",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1116.0",
    "@base-ui/react": "^1.7.0",
    "@better-auth/api-key": "^1.7.1",
    "@orpc/contract": "^1.15.0",
    "@orpc/server": "^1.15.0",
    "@orpc/zod": "^1.15.0",
    "better-auth": "^1.7.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.33.0",
    "next": "16.3.2",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "shadcn": "^4.19.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.12",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "^0.35.3",
    "esbuild": "0.28.1",
    "@babel/plugin-transform-runtime": "^7.29.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.2",
    "fallow": "^3.17.0",
    "jsdom": "^30.0.1",
    "npm-check-updates": "^23.0.2",
    "tailwindcss": "^4",
    "typescript": "^6",
    "vitest": "^4.1.11"
  }
}
