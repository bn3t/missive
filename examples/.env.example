# Example environment for a Docker Compose deployment.
# Copy next to examples/docker-compose.yml as ".env" and fill it in.
# See the "Deploy with Docker" chapter of the README.

# ─── Postgres ────────────────────────────────────────────
POSTGRES_PASSWORD=replace-with-a-long-random-password

# ─── Core ────────────────────────────────────────────────
# Host "postgres" is the compose service name; password must match POSTGRES_PASSWORD.
DATABASE_URL=postgres://missive:replace-with-a-long-random-password@postgres:5432/missive

# ─── Auth ────────────────────────────────────────────────
# openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-chars
# Public URL of the instance, as seen by the browser.
BETTER_AUTH_URL=https://missive.example.com

# Self-service signup page. Keep it false on a server and create the first
# user with `docker compose exec ... npm run seed:deploy` instead.
SIGNUP_ENABLED=false

# ─── Email ───────────────────────────────────────────────
# Comma-separated list of enabled transports: ses, smtp (or both).
EMAIL_TRANSPORTS=smtp
EMAIL_FROM="Missive <noreply@example.com>"

# ─── SMTP Transport ──────────────────────────────────────
# Required when "smtp" is in EMAIL_TRANSPORTS.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ─── SES Transport ───────────────────────────────────────
# Required when "ses" is in EMAIL_TRANSPORTS.
# AWS_REGION=eu-central-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
